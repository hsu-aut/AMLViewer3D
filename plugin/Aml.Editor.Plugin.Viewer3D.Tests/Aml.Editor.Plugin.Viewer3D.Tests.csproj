<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWPF leaves System.IO out of the implicit usings (WPF has a Path class of its own). -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The plugin leaves these to the editor; the tests have no editor. -->
    <PackageReference Include="Aml.Engine" Version="[4.5.2]" />
    <PackageReference Include="Aml.Editor.Plugin.Contract" Version="[4.3.0]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aml.Editor.Plugin.Viewer3D\Aml.Editor.Plugin.Viewer3D.csproj" />
  </ItemGroup>
</Project>
