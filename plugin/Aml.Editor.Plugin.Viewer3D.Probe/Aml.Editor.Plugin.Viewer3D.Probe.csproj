<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Hosts the plugin outside the AutomationML Editor, the way the editor does: a WPF
    window, a CAEXDocument handed over with DocumentLoaded, selections in both
    directions. For checking the plugin without installing it; not shipped.
    Usage: see Program.cs.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- What the editor provides to the plugin at run time. -->
    <PackageReference Include="Aml.Engine" Version="[4.5.2]" />
    <PackageReference Include="Aml.Editor.Plugin.Contract" Version="[4.3.0]" />
    <PackageReference Include="Aml.Editor.API" Version="[2.3.0]" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4191.47]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aml.Editor.Plugin.Viewer3D\Aml.Editor.Plugin.Viewer3D.csproj" />
  </ItemGroup>
</Project>
