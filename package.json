{
  "name": "aml-viewer-3d",
  "version": "0.1.0",
  "description": "AutomationML documents with their COLLADA geometry and kinematics in the browser (IEC 62714-3).",
  "license": "MIT",
  "author": "Hamied Nabizada",
  "type": "module",
  "keywords": [
    "automationml",
    "aml",
    "caex",
    "collada",
    "iec-62714",
    "three.js",
    "kinematics"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs",
    "fixtures:check": "node scripts/make-fixtures.mjs --check",
    "test:robotcell": "vitest run --config vitest.robotcell.config.ts",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
